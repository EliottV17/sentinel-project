# Compose PostgreSQL role; keep it identical to DATABASE_URL's username.
POSTGRES_USER=postgres
# Generate a fresh URL-safe password; it must not equal the default "postgres".
POSTGRES_PASSWORD=REPLACE_WITH_FRESH_DATABASE_PASSWORD
# Compose PostgreSQL database; keep it identical to DATABASE_URL's path.
POSTGRES_DB=sentinel_db
# Container URL; credentials and database must match the PostgreSQL settings above.
DATABASE_URL=postgresql://postgres:REPLACE_WITH_FRESH_DATABASE_PASSWORD@db:5432/sentinel_db
# Generate a distinct random signing key; 32 or more characters are recommended.
SECRET_KEY=REPLACE_WITH_A_DISTINCT_RANDOM_SIGNING_SECRET
# JWT signing algorithm; this project uses HS256 by default.
ALGORITHM=HS256
# Ordinary access-token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Exact allowed browser origin; match SITE_ADDRESS with scheme and no path.
CORS_ORIGINS=https://sentinel.example.com
# Public demo login identity; it must differ from the status owner.
DEMO_USER_EMAIL=demo@example.invalid
# Choose a strong deliberately PUBLIC demo password, embedded in the frontend.
DEMO_USER_PASSWORD=REPLACE_WITH_A_PUBLIC_DEMO_PASSWORD
# Separate valid owner identity for anonymously visible status monitors.
STATUS_OWNER_EMAIL=status-owner@example.invalid
# Demo access-token lifetime in minutes.
DEMO_ACCESS_TOKEN_EXPIRE_MINUTES=15
# Demo-account monitor quota.
DEMO_MAX_MONITORS=3
# Minimum demo monitor interval in seconds.
DEMO_MIN_FREQUENCY_SECONDS=60
# Periodic demo reconciliation interval in minutes.
DEMO_RESET_INTERVAL_MINUTES=60
# General authenticated-user monitor quota.
MAX_MONITORS_PER_USER=10
# Minimum general monitor interval in seconds.
MIN_MONITOR_FREQUENCY_SECONDS=60
# Public uptime aggregation window in hours.
STATUS_UPTIME_WINDOW_HOURS=24
# Public-status cache lifetime in seconds.
STATUS_CACHE_TTL_SECONDS=30
# Frontend considers checks older than this many minutes stale.
STATUS_STALE_AFTER_MINUTES=5
# Frontend healthy-state degradation threshold in percent.
STATUS_DEGRADED_THRESHOLD_PERCENT=99
# Worker HTTP checker port allowlist.
ALLOWED_PORTS=80,443,8080,8443
# Worker database-operation deadline in seconds.
WORKER_DB_TIMEOUT_SECONDS=10
# Worker health-command database deadline in seconds.
WORKER_HEALTH_DB_TIMEOUT_SECONDS=5
# Worker heartbeat file inside its container.
WORKER_HEARTBEAT_PATH=/tmp/sentinel-worker.heartbeat
# Heartbeat freshness in seconds; minimum is 4 times DB timeout plus 27.
WORKER_HEARTBEAT_MAX_AGE_SECONDS=67
# Check-history retention in days; it must cover the uptime window.
CHECK_RESULT_RETENTION_DAYS=30
# Alert-history retention in days.
ALERT_RETENTION_DAYS=90
# Retention cadence in minutes, from 1 through 1440.
RETENTION_INTERVAL_MINUTES=60
# Maximum rows per cleanup batch, from 1 through 5000.
RETENTION_BATCH_SIZE=500
# Retention-query database deadline in seconds, from 1 through 3600.
RETENTION_DB_TIMEOUT_SECONDS=5
# Default per-IP throttle window in milliseconds.
THROTTLE_DEFAULT_TTL=60000
# Default per-IP request limit within the throttle window.
THROTTLE_DEFAULT_LIMIT=100
# Authentication throttle window in milliseconds.
THROTTLE_AUTH_TTL=60000
# Authentication requests allowed per IP within the window.
THROTTLE_AUTH_LIMIT=5
# Monitor-mutation throttle window in milliseconds.
THROTTLE_MONITORS_TTL=60000
# Monitor mutations allowed per IP within the window.
THROTTLE_MONITORS_LIMIT=20
# Caddy public hostname; use localhost only for local private-CA testing.
SITE_ADDRESS=sentinel.example.com

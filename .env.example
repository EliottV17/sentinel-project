DEMO_USER_EMAIL=demo@sentinel.dev
DEMO_USER_PASSWORD=DemoPassword123!
DEMO_ACCESS_TOKEN_EXPIRE_MINUTES=15
DEMO_MAX_MONITORS=3
DEMO_MIN_FREQUENCY_SECONDS=60
DEMO_RESET_INTERVAL_MINUTES=60
DEMO_MONITORS_MANIFEST_PATH=/app/demo-monitors.json

# Only needed when building the frontend independently.
# Docker Compose maps the DEMO_USER values to these build arguments.
VITE_DEMO_USER_EMAIL=demo@sentinel.dev
VITE_DEMO_USER_PASSWORD=DemoPassword123!
SECRET_KEY=change-me-to-a-random-secret
CORS_ORIGINS=http://localhost:5173

STATUS_OWNER_EMAIL=pon-aqui-un-email-poco-obvio@example.com

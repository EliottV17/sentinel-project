# Base URL of the sentinel API (default empty).
# Dev: leave empty and rely on the Vite dev-server proxy (/api -> http://localhost:8000).
# Prod (separate origin): set to the API origin, e.g. VITE_API_BASE_URL=https://api.example.com
# (requires CORS_ORIGINS on the API to list the SPA origin).
VITE_API_BASE_URL=

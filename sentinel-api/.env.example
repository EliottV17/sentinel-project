DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/sentinel_db
SECRET_KEY=change-me-to-a-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Orígenes permitidos para CORS, separados por comas (p. ej. el origen del SPA).
# Vacío por defecto: CORS_ORIGINS="" desactiva todo acceso cross-origin.
CORS_ORIGINS=

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model alembic_version {
  version_num String @id(map: "alembic_version_pkc") @db.VarChar(32)
}

model alert {
  id         Int      @id @default(autoincrement())
  monitor_id Int
  alert_type String   @db.VarChar
  message    String   @db.VarChar
  created_at DateTime @db.Timestamp(6)
  monitor    monitor  @relation(fields: [monitor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model check_result {
  id              Int      @id @default(autoincrement())
  monitor_id      Int
  state           String   @db.VarChar
  status_code     Int?
  latency_ms      Float?
  response_sample String?  @db.VarChar
  error_message   String?  @db.VarChar
  extra_data      Json?    @db.Json
  created_at      DateTime @db.Timestamp(6)
  monitor         monitor  @relation(fields: [monitor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([monitor_id], map: "ix_check_result_monitor_id")
}

model monitor {
  id                   Int            @id @default(autoincrement())
  name                 String         @db.VarChar
  target               String         @db.VarChar
  frequency            Int
  state                String         @db.VarChar
  created_at           DateTime       @db.Timestamp(6)
  check_type           String         @db.VarChar
  check_config         Json?          @db.Json
  last_state           String?        @db.VarChar
  last_checked_at      DateTime?      @db.Timestamp(6)
  consecutive_failures Int
  user_id              Int
  alert                alert[]
  check_result         check_result[]
  users                users          @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([name], map: "ix_monitor_name")
}

model users {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar
  last_name   String    @db.VarChar
  username    String    @unique(map: "ix_users_username") @db.VarChar
  email       String    @unique(map: "ix_users_email") @db.VarChar
  password    String    @db.VarChar
  phonenumber String?   @db.VarChar
  created_at  DateTime  @db.Timestamp(6)
  updated_at  DateTime  @db.Timestamp(6)
  status      String?   @db.VarChar
  is_active   Boolean
  monitor     monitor[]

  @@index([last_name], map: "ix_users_last_name")
  @@index([name], map: "ix_users_name")
}

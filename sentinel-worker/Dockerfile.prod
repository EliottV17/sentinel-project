FROM golang:1.25-alpine AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/worker ./cmd/worker/

FROM alpine:3.20 AS runtime
RUN apk add --no-cache ca-certificates tzdata \
    && addgroup -S -g 10001 sentinel \
    && adduser -S -u 10001 -G sentinel sentinel \
    && mkdir -p /tmp \
    && chown sentinel:sentinel /tmp
COPY --from=builder --chown=sentinel:sentinel /out/worker /worker
USER 10001:10001
ENTRYPOINT ["/worker"]
